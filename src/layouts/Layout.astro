---
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: string;
}

const {
  title,
  description = "Aapka bharosemand platform Smart TV troubleshooting, Android TV & Google TV sideloading guides, Custom ROM installation, aur best budget gadget reviews ke liye.",
  image = "/images/gyan-browser-og.jpg",
  canonicalURL = Astro.url.href,
  type = "website"
} = Astro.props;
---

<!doctype html>
<html lang="hi" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- Schema.org JSON-LD for Google Rich Results -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Gyan Browser",
        "url": "https://gyanbrowser.github.io",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://gyanbrowser.github.io/search?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>
  </head>
  <body class="bg-slate-50 text-slate-900 dark:bg-darkbg dark:text-slate-100 font-['Inter',sans-serif] min-h-screen flex flex-col transition-colors duration-200">
    
    <!-- Top Utility Bar -->
    <div class="bg-[#060911] text-slate-300 text-xs py-2 border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 flex justify-between items-center flex-wrap gap-2">
        <div class="flex gap-4 font-medium">
          <a href="/" class="hover:text-white">Home</a>
          <a href="/about" class="hover:text-white">About Us</a>
          <a href="/contact" class="hover:text-white">Contact Us</a>
          <a href="/privacy-policy" class="hover:text-white">Privacy Policy</a>
        </div>
        <div class="flex items-center gap-4">
          <a href="https://www.youtube.com/@realgyanbrowser" target="_blank" rel="noopener" class="text-rose-400 hover:text-rose-300 font-semibold flex items-center gap-1.5">
            <i class="fa-brands fa-youtube"></i> YouTube (@realgyanbrowser)
          </a>
        </div>
      </div>
    </div>

    <!-- Main Sticky Header -->
    <header class="sticky top-0 z-50 bg-[#0f172a] text-white shadow-lg">
      <div class="max-w-7xl mx-auto px-4 h-[72px] flex justify-between items-center gap-4">
        <!-- Brand -->
        <a href="/" class="flex items-center gap-3 group">
          <span class="bg-gradient-to-br from-rose-600 to-blue-600 text-white font-extrabold text-lg w-10 h-10 rounded-xl flex items-center justify-center shadow">GB</span>
          <span class="text-xl font-extrabold tracking-tight group-hover:text-rose-500 transition-colors">Gyan Browser</span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-1 text-sm font-semibold">
          <a href="/" class="px-3 py-2 rounded-lg hover:bg-white/10 transition">Home</a>
          <a href="/category/android-tv" class="px-3 py-2 rounded-lg hover:bg-white/10 transition">Android & Google TV</a>
          <a href="/category/fire-tv" class="px-3 py-2 rounded-lg hover:bg-white/10 transition">Fire TV Stick</a>
          <a href="/category/projector" class="px-3 py-2 rounded-lg hover:bg-white/10 transition">Projectors</a>
          <a href="/category/mobile-tips" class="px-3 py-2 rounded-lg hover:bg-white/10 transition">Mobile & ADB</a>
          <a href="https://www.youtube.com/@realgyanbrowser" target="_blank" rel="noopener" class="ml-2 bg-rose-600 hover:bg-rose-700 text-white px-4 py-2 rounded-lg flex items-center gap-2 transition shadow">
            <i class="fa-brands fa-youtube"></i> Subscribe
          </a>
        </nav>

        <!-- Actions -->
        <div class="flex items-center gap-2">
          <button id="themeToggle" aria-label="Toggle Dark Mode" class="w-10 h-10 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center text-amber-400 text-base transition">
            <i class="fa-solid fa-moon" id="themeIcon"></i>
          </button>
        </div>
      </div>
    </header>

    <!-- Quick Trending Topics Bar -->
    <div class="bg-white dark:bg-darkcard border-b border-slate-200 dark:border-slate-800 py-3">
      <div class="max-w-7xl mx-auto px-4 flex items-center gap-3 overflow-x-auto no-scrollbar">
        <span class="bg-rose-600 text-white text-[11px] font-bold uppercase px-2.5 py-1 rounded-md whitespace-nowrap flex items-center gap-1.5">
          <i class="fa-solid fa-bolt"></i> Quick Guides
        </span>
        <a href="/category/android-tv" class="text-xs font-semibold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-3 py-1.5 rounded-full whitespace-nowrap hover:border-rose-600 hover:text-rose-600 transition">#AndroidTV Guides</a>
        <a href="/category/custom-rom" class="text-xs font-semibold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-3 py-1.5 rounded-full whitespace-nowrap hover:border-rose-600 hover:text-rose-600 transition">#ATV9 Custom ROM</a>
        <a href="/category/projector" class="text-xs font-semibold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-3 py-1.5 rounded-full whitespace-nowrap hover:border-rose-600 hover:text-rose-600 transition">#Projector Reviews</a>
        <a href="/category/sideload" class="text-xs font-semibold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-3 py-1.5 rounded-full whitespace-nowrap hover:border-rose-600 hover:text-rose-600 transition">#APK Sideloading</a>
      </div>
    </div>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Clean Footer -->
    <footer class="bg-[#060911] text-slate-400 py-12 mt-16 border-t border-white/10">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          <div>
            <h4 class="text-white font-bold text-base mb-3 flex items-center gap-2">
              <span class="bg-rose-600 text-white w-7 h-7 rounded-lg inline-flex items-center justify-center text-xs">GB</span>
              Gyan Browser - Tech Gyan in Simple Way
            </h4>
            <p class="text-sm leading-relaxed">
              Aapka bharosemand platform Smart TV troubleshooting, Android TV & Google TV sideloading guides, Custom ROM installation, aur best budget gadget reviews ke liye.
            </p>
          </div>
          <div>
            <h4 class="text-white font-bold text-base mb-3">Top Categories</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/category/android-tv" class="hover:text-white transition">Android & Google TV</a></li>
              <li><a href="/category/projector" class="hover:text-white transition">Budget Projectors</a></li>
              <li><a href="/category/custom-rom" class="hover:text-white transition">TV Box Custom ROMs</a></li>
              <li><a href="/category/mobile-tips" class="hover:text-white transition">Smartphone Tips</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-bold text-base mb-3">Important Links</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/about" class="hover:text-white transition">About Us</a></li>
              <li><a href="/contact" class="hover:text-white transition">Contact Us</a></li>
              <li><a href="/privacy-policy" class="hover:text-white transition">Privacy Policy</a></li>
              <li><a href="/disclaimer" class="hover:text-white transition">Disclaimer</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-white/10 pt-6 text-center text-xs">
          &copy; 2026 <strong>Gyan Browser</strong> (@realgyanbrowser). All Rights Reserved.
        </div>
      </div>
    </footer>

    <script>
      const toggleBtn = document.getElementById('themeToggle');
      const themeIcon = document.getElementById('themeIcon');
      
      if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
        themeIcon.className = 'fa-solid fa-sun';
      }

      toggleBtn.addEventListener('click', () => {
        document.documentElement.classList.toggle('dark');
        if (document.documentElement.classList.contains('dark')) {
          localStorage.setItem('theme', 'dark');
          themeIcon.className = 'fa-solid fa-sun';
        } else {
          localStorage.setItem('theme', 'light');
          themeIcon.className = 'fa-solid fa-moon';
        }
      });
    </script>
  </body>
</html>
