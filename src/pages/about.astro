---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About Us - Gyan Browser">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="bg-white dark:bg-darkcard p-8 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
      <h1 class="text-3xl font-extrabold mb-6">About Gyan Browser</h1>
      <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
        Welcome to <strong>Gyan Browser</strong> (`@realgyanbrowser`), aapka trusted hub for Smart TV troubleshooting, Android TV & Google TV sideloading guides, Custom ROM installation, aur best budget gadget reviews ke liye.
      </p>
    </div>
  </div>
</Layout>
