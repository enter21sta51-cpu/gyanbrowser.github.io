---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';

const posts = [
  {
    title: "How to Install Cricfy TV on Android & Google TV (2026 Guide)",
    snippet: "Are you looking to enjoy Cricfy TV on your Android device or Google TV in 2026? Follow this complete sideloading tutorial...",
    tag: "ANDROID-TV",
    date: "January 25, 2026",
    url: "/posts/install-cricfy-tv-android-tv",
    bg: "from-emerald-900 to-teal-700"
  },
  {
    title: "Best Budget Projector in India - Wzatco Yuva Go Pro Automatic Review",
    snippet: "Are you searching for the best budget projector in India for 2025/2026? The Wzatco Yuva Go Pro Automatic projector brings 4K support...",
    tag: "PROJECTOR",
    date: "December 17, 2025",
    url: "/posts/wzatco-yuva-go-pro-projector-review",
    bg: "from-indigo-950 to-indigo-800"
  },
  {
    title: "Android TV 9 Custom ROM Review: X96 Mini 4K Gaming & Streaming Test",
    snippet: "Android TV 9 custom ROM transforms budget Amlogic S905W boxes like the X96 Mini (2GB RAM, 16GB storage) into a smooth entertainment device...",
    tag: "CUSTOM-ROM",
    date: "December 09, 2025",
    url: "/posts/x96-mini-android-tv-9-custom-rom",
    bg: "from-slate-900 to-emerald-900"
  },
  {
    title: "BEST Way to Install ATV9 on Amlogic S905W Device (X96 Mini Guide)",
    snippet: "Android TV 9 (ATV 9) can be installed on Amlogic S905W devices like the X96 Mini using a PC, USB Burning Tool, and ROM file...",
    tag: "ANDROID-TV",
    date: "December 14, 2025",
    url: "/posts/install-atv9-amlogic-s905w-x96-mini",
    bg: "from-red-950 to-rose-900"
  }
];
---

<Layout title="Gyan Browser - Tech Gyan in Simple Way">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Left 2 Columns: Post Cards Grid -->
      <div class="lg:col-span-2">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {posts.map(post => (
            <article class="bg-white dark:bg-darkcard border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition flex flex-col group">
              <a href={post.url} class={`relative aspect-video bg-gradient-to-br ${post.bg} p-6 flex flex-col justify-end text-white overflow-hidden`}>
                <span class="absolute top-3 left-3 bg-rose-600 text-white text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-md tracking-wider">
                  {post.tag}
                </span>
                <h3 class="text-base font-black leading-tight drop-shadow-md group-hover:underline">
                  {post.title}
                </h3>
              </a>
              <div class="p-5 flex flex-col flex-1">
                <h3 class="font-bold text-base mb-2 leading-snug">
                  <a href={post.url} class="hover:text-rose-600 transition">{post.title}</a>
                </h3>
                <p class="text-xs text-slate-600 dark:text-slate-400 mb-4 flex-1 line-clamp-3">
                  {post.snippet}
                </p>
                <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex justify-between items-center text-xs text-slate-500">
                  <span><i class="fa-regular fa-calendar"></i> {post.date}</span>
                  <a href={post.url} class="font-bold text-rose-600 hover:text-rose-700 flex items-center gap-1">
                    Read Guide <i class="fa-solid fa-arrow-right"></i>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- Pagination -->
        <div class="mt-8 text-center">
          <span class="inline-block bg-rose-600 text-white font-bold text-sm px-6 py-3 rounded-xl shadow">
            Older Guides <i class="fa-solid fa-arrow-right ml-1"></i>
          </span>
        </div>
      </div>

      <!-- Right Column: Sidebar -->
      <div>
        <Sidebar />
      </div>

    </div>
  </div>
</Layout>
