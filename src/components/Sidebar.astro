---
<aside class="space-y-6">
  <!-- Search Box -->
  <form action="/search" method="get" class="flex gap-2 bg-white dark:bg-darkcard p-2 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
    <input type="text" name="q" placeholder="Search TV guides, ROMs..." class="flex-1 bg-transparent px-3 py-2 text-sm focus:outline-none text-slate-800 dark:text-slate-100" />
    <button type="submit" class="bg-rose-600 hover:bg-rose-700 text-white px-4 py-2 rounded-lg text-sm font-semibold transition">
      <i class="fa-solid fa-magnifying-glass"></i>
    </button>
  </form>

  <!-- YouTube Promo Box -->
  <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-2xl p-6 text-center shadow-lg border border-slate-800">
    <div class="bg-rose-600 text-white text-xs font-extrabold px-3 py-1 rounded-md inline-block mb-3">
      <i class="fa-brands fa-youtube"></i> OFFICIAL CHANNEL
    </div>
    <h3 class="text-lg font-extrabold mb-2">Gyan Browser</h3>
    <p class="text-xs text-slate-300 mb-5 leading-relaxed">
      Smart TV Tutorials, Android TV Guides, Projector Reviews & Useful Tech Tricks in Simple Hindi!
    </p>
    <a href="https://www.youtube.com/@realgyanbrowser" target="_blank" rel="noopener" class="bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs py-2.5 px-4 rounded-xl block transition shadow">
      <i class="fa-brands fa-youtube"></i> Subscribe @realgyanbrowser
    </a>
  </div>

  <!-- Popular Guides Widget -->
  <div class="bg-white dark:bg-darkcard rounded-2xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
    <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white mb-4 pb-2 border-b-2 border-rose-600 inline-block">Popular Tech Guides</h3>
    <div class="space-y-4">
      <a href="/posts/install-cricfy-tv-android-tv" class="flex items-center gap-3 group">
        <span class="w-7 h-7 rounded-lg bg-rose-50 dark:bg-rose-950/50 text-rose-600 font-extrabold text-xs flex items-center justify-center shrink-0">1</span>
        <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200 group-hover:text-rose-600 transition leading-snug">How to Install Cricfy TV on Android & Google TV (2026 Guide)</h4>
      </a>
      <a href="/posts/x96-mini-android-tv-9-custom-rom" class="flex items-center gap-3 group">
        <span class="w-7 h-7 rounded-lg bg-rose-50 dark:bg-rose-950/50 text-rose-600 font-extrabold text-xs flex items-center justify-center shrink-0">2</span>
        <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200 group-hover:text-rose-600 transition leading-snug">Android TV 9 Custom ROM Review: X96 Mini 4K Gaming Test</h4>
      </a>
      <a href="/posts/wzatco-yuva-go-pro-projector-review" class="flex items-center gap-3 group">
        <span class="w-7 h-7 rounded-lg bg-rose-50 dark:bg-rose-950/50 text-rose-600 font-extrabold text-xs flex items-center justify-center shrink-0">3</span>
        <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200 group-hover:text-rose-600 transition leading-snug">Best Budget Projector in India - Wzatco Yuva Go Pro Review</h4>
      </a>
    </div>
  </div>

  <!-- Tech Categories Widget -->
  <div class="bg-white dark:bg-darkcard rounded-2xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
    <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white mb-4 pb-2 border-b-2 border-rose-600 inline-block">Tech Categories</h3>
    <ul class="space-y-2 text-sm font-semibold">
      <li>
        <a href="/category/android-tv" class="flex justify-between items-center p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 hover:bg-rose-50 hover:text-rose-600 transition">
          <span>Android-TV</span>
          <span class="bg-rose-100 text-rose-600 text-xs px-2.5 py-0.5 rounded-full font-bold">3 Guides</span>
        </a>
      </li>
      <li>
        <a href="/category/custom-rom" class="flex justify-between items-center p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 hover:bg-rose-50 hover:text-rose-600 transition">
          <span>Custom-ROM</span>
          <span class="bg-rose-100 text-rose-600 text-xs px-2.5 py-0.5 rounded-full font-bold">2 Guides</span>
        </a>
      </li>
      <li>
        <a href="/category/projector" class="flex justify-between items-center p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 hover:bg-rose-50 hover:text-rose-600 transition">
          <span>Projector</span>
          <span class="bg-rose-100 text-rose-600 text-xs px-2.5 py-0.5 rounded-full font-bold">1 Guide</span>
        </a>
      </li>
    </ul>
  </div>
</aside>
